{
  "controls": [
    {
      "id": "control-app-change",
      "attack": "a small app change outside every locked path",
      "source": "the suite's own control",
      "base": { "web/totals.js": "export const total = 1;\n" },
      "change": [{ "write": "web/totals.js", "text": "export const total = 2;\n" }],
      "expect": { "decision": "merges", "configs": ["engine", "default", "loosened"], "scopes": ["engine", "managed-app"] }
    },
    {
      "id": "control-docs-change",
      "attack": "a docs change outside the design rules",
      "source": "the suite's own control",
      "change": [{ "write": "docs/guide.md", "text": "# Guide\n\nHow to start.\n" }],
      "expect": { "decision": "merges", "configs": ["engine", "default", "loosened"], "scopes": ["engine", "managed-app"] }
    },
    {
      "id": "control-test-change",
      "attack": "a change to a test that holds no control",
      "source": "the suite's own control",
      "base": { "test/totals.test.ts": "test('totals');\n" },
      "change": [{ "write": "test/totals.test.ts", "text": "test('totals add up');\n" }],
      "expect": { "decision": "merges", "configs": ["engine", "default", "loosened"], "scopes": ["engine", "managed-app"] }
    },
    {
      "id": "control-src-in-managed-app",
      "attack": "a change to an app's own src/ (the engine's source locks stand aside in a managed app)",
      "source": "the suite's own control (#665)",
      "base": { "src/totals.ts": "export const total = 1;\n" },
      "change": [{ "write": "src/totals.ts", "text": "export const total = 2;\n" }],
      "expect": { "decision": "merges", "configs": ["default", "loosened"], "scopes": ["engine", "managed-app"] }
    },
    {
      "id": "control-planned-app-change",
      "attack": "a planned task whose PR changes only what its plan lists",
      "source": "the suite's own control (outside-plan cases)",
      "base": { "web/totals.js": "export const total = 1;\n" },
      "change": [{ "write": "web/totals.js", "text": "export const total = 2;\n" }],
      "inputs": { "plan": ["web/totals.js"] },
      "expect": { "decision": "merges", "configs": ["engine", "default", "loosened"], "scopes": ["engine", "managed-app"] }
    },
    {
      "id": "control-test-added-weakening-read",
      "attack": "a new test, with the change read for a weakened test, lint or guard",
      "source": "the suite's own control (weakening cases)",
      "change": [{ "write": "test/round.test.ts", "text": "test('totals round', () => {\n  assert.equal(round(2.5), 3);\n});\n" }],
      "inputs": { "weakening": true },
      "expect": { "decision": "merges", "configs": ["engine", "default", "loosened"], "scopes": ["engine", "managed-app"] }
    },
    {
      "id": "control-app-change-in-flow",
      "attack": "a small app change outside every locked path, decided by the coordinator's own mergeDecisionFor",
      "source": "the suite's own control (flow cases)",
      "base": { "web/totals.js": "export const total = 1;\n" },
      "change": [{ "write": "web/totals.js", "text": "export const total = 2;\n" }],
      "flow": {},
      "expect": { "decision": "merges", "configs": ["engine", "default", "loosened"], "scopes": ["engine", "managed-app"] }
    }
  ]
}

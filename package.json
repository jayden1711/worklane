{
  "name": "@worklane/cli",
  "version": "0.2.0",
  "description": "Open-source harness for running a crew of Claude agents on a real codebase: parallel workers, an independent evaluator, a shared GitHub Issues backlog, and a live dashboard showing who owns every task.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayden1711/worklane.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "worklane": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/web",
    "templates",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "rename": "node scripts/rename.mjs",
    "check:dco": "node scripts/check-dco.mjs",
    "check:denylist": "node scripts/check-denylist.mjs",
    "build:web": "vite build --config web/vite.config.ts --logLevel warn && node scripts/web-licenses.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.3",
    "vite": "8.3.0"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
